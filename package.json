{
  "name": "ai-project-manager",
  "version": "0.1.1",
  "private": true,
  "description": "面向 AI 辅助开发的本地项目工作台",
  "license": "MIT",
  "type": "module",
  "main": ".runtime/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "desktop": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "package:win": "node scripts/package-windows.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.desktop.json",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:desktop:launch": "node scripts/smoke-launcher.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.57.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.8.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true,
    "electron@44.8.0": true
  }
}
